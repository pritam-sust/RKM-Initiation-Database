{
  "name": "rkm-initiation-database",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "db:seed": "npx prisma db seed",
    "deploy:package": "DEPLOY_DIR=\"$HOME/Desktop/rkm-deploy\" && rm -rf \"$DEPLOY_DIR\" && mkdir -p \"$DEPLOY_DIR\" && cp -r .next/standalone \"$DEPLOY_DIR/\" && cp -r .next/static \"$DEPLOY_DIR/standalone/.next/static\" && cp -r public \"$DEPLOY_DIR/standalone/public\" && cp -r prisma \"$DEPLOY_DIR/\" && cd \"$(dirname $DEPLOY_DIR)\" && zip -r rkm-deploy.zip \"$(basename $DEPLOY_DIR)/\" && echo \"✅ Package ready: $(dirname $DEPLOY_DIR)/rkm-deploy.zip\""
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "pdf-parse": "^1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/word-extractor": "^1.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
